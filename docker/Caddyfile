# Caddy in front of Favabooks (docker-compose-login.yml): asks for a
# username and password, then passes everything through to Favabooks.
# Fava has no login of its own.
#
# Mounted into the official Caddy image as /etc/caddy/Caddyfile. The login
# comes from .env (FAVABOOKS_LOGIN_USER and FAVABOOKS_LOGIN_HASH, a bcrypt
# hash), passed in by the compose file, which refuses to start without
# them, so Favabooks is never served without the login.
{
	admin off
	auto_https off
}

:80 {
	basic_auth {
		{$FAVABOOKS_LOGIN_USER} {$FAVABOOKS_LOGIN_HASH}
	}
	reverse_proxy favabooks:5000
}
