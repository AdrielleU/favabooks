# Copy to .env (git ignores it) and fill in. Used by docker-compose-login.yml.

# The login (Caddy's popup). The password is stored only as a bcrypt hash, never in plain text.
# 1. Paste this command exactly as it is (Podman: podman instead of docker). Do NOT put your password in it:
#      docker run --rm -it docker.io/library/caddy:2.11.7-alpine sh -c 'h=$(caddy hash-password) && printf "FAVABOOKS_LOGIN_HASH=\047%s\047\n" "$h"'
#    It then asks; type the password at the prompts (nothing shows; use 12+ characters):
#      Enter password:      <- your password, Enter
#      Confirm password:    <- the same again, Enter
#      FAVABOOKS_LOGIN_HASH='$2a$14$...'    <- the finished line, quotes included: copy all of it
# 2. Paste that line over FAVABOOKS_LOGIN_HASH= below, and set your username in FAVABOOKS_LOGIN_USER=
# 3. Start or restart: docker compose -f docker-compose-login.yml up -d
FAVABOOKS_LOGIN_USER=admin
FAVABOOKS_LOGIN_HASH=

# Optional: the image version (https://github.com/AdrielleU/favabooks/releases, e.g. 0.4.3; default latest),
# the port people open (default 5000), the first company's name, and what to create on first run.
FAVABOOKS_TAG=
FAVABOOKS_PORT=
FAVABOOKS_COMPANY=
FAVABOOKS_STARTER=
